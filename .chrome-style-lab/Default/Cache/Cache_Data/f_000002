  line-height: 1.6;
}
.hero-visual {
  position: relative;
  min-height: 500px;
}
.route {
  position: absolute;
  left: 42px;
  top: 27px;
  bottom: 24px;
  width: 4px;
  border-radius: 4px;
  background:
    linear-gradient(
      var(--signal) 0 10%,
      var(--line) 10% 65%,
      var(--primary) 65% 100%);
}
.route::before,
.route::after {
  content: "";
  position: absolute;
  left: 50%;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  transform: translateX(-50%);
}
.route::before {
  top: 0;
  background: var(--signal);
}
.route::after {
  bottom: 0;
  background: var(--primary);
}
.visual-card {
