  padding-right: 35px;
  margin-bottom: 25px;
  font-size: 15px;
}
.contact {
  padding: 92px;
  border-radius: 30px;
  background: var(--primary);
  color: #fff;
}
.contact .eyebrow {
  color: #ccd6ff;
}
.contact h2 {
  max-width: 850px;
}
.contact p {
  max-width: 690px;
  color: #dbe1ff;
  font-size: 18px;
}
.contact-actions {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-top: 34px;
}
.contact .text-link {
  color: #fff;
}
.contact-placeholder {
  cursor: default;
}
.response-note {
  margin-top: 24px;
  color: #c6d0ff;
  font-size: 13px;
