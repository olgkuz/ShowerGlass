}
.service-card h3 {
  max-width: 480px;
  margin-bottom: 13px;
  font-size: 31px;
}
.service-card > p {
  max-width: 560px;
}
.service-list {
  display: grid;
  gap: 11px;
  margin: 20px 0 34px;
  padding: 0;
  list-style: none;
  color: #3f4853;
}
.service-list li {
  position: relative;
  padding-left: 21px;
  font-size: 15px;
  line-height: 1.45;
}
.service-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.6em;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--signal);
}
.service-footer {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
  margin-top: auto;
  padding-top: 25px;
  border-top: 1px solid var(--line);
}
.price {
  font-size: 25px;
  font-weight: 650;
  letter-spacing: -0.025em;
}
.term {
  display: block;
  margin-top: 6px;
  color: var(--muted);
  font-size: 13px;
}
.service-footer a {
  white-space: nowrap;
}
.price-note {
  margin: 22px 0 0;
  font-size: 14px;
}
.cases-grid {
  display: grid;
  grid-template-columns: 1.12fr 0.88fr;
  gap: 20px;
}
.case-card {
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--dark);
  color: #fff;
  text-decoration: none;
}
.case-media {
  position: relative;
  height: 420px;
  overflow: hidden;
  background: #e9e4db;
