  margin-bottom: 25px;
  color: #cbd1d8;
}
.case-arrow {
  font-weight: 600;
}
.process-wrap {
  border-radius: 30px;
  background: var(--dark);
  color: #fff;
}
.process {
  display: grid;
  grid-template-columns: 0.88fr 1.12fr;
  gap: 80px;
  padding: 86px;
}
.process .eyebrow {
  color: #91a5ff;
}
.process p {
  color: #b9c0c9;
}
.steps {
  border-top: 1px solid #39414c;
}
.step {
  display: grid;
  grid-template-columns: 58px 1fr;
  gap: 19px;
  padding: 24px 0;
  border-bottom: 1px solid #39414c;
}
.step .mono {
  padding-top: 4px;
  color: #91a5ff;
}
.step strong {
  display: block;
  font-size: 19px;
}
.step span {
  display: block;
  margin-top: 5px;
  color: #aeb6c0;
  font-size: 14px;
  line-height: 1.5;
}
.about {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 86px;
  align-items: start;
}
.about-panel {
  min-height: 450px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 36px;
  border-radius: var(--radius);
  background: var(--primary);
  color: #fff;
