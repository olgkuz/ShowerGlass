  font-size: 22px;
  line-height: 1.15;
  letter-spacing: -0.025em;
}
.education-kind {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.45;
}
.education-place {
  margin-top: auto;
  padding-top: 24px;
  color: var(--ink);
  font-size: 12px;
  font-weight: 600;
}
.faq {
  display: grid;
  grid-template-columns: 0.72fr 1.28fr;
  gap: 80px;
}
.faq-list {
  border-top: 1px solid var(--line);
}
details {
  border-bottom: 1px solid var(--line);
}
summary {
  position: relative;
  padding: 24px 44px 24px 0;
  font-size: 18px;
  font-weight: 600;
  cursor: pointer;
  list-style: none;
}
