  gap: 5px;
  margin-bottom: 14px;
}
.browser-dots i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--line);
}
.site-mini {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 14px;
}
.site-mini div {
  min-height: 102px;
  border-radius: 11px;
}
.mini-copy {
  background:
    linear-gradient(
      var(--dark) 0 14px,
      transparent 14px 31px,
      #d8dce2 31px 39px,
      transparent 39px 52px,
      #d8dce2 52px 60px,
      transparent 60px 74px,
      var(--primary) 74px 100%);
}
.mini-image {
  background:
    linear-gradient(
      140deg,
      #a9bbb7,
      #e9dfd0);
}
.needs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: rgba(255, 255, 255, 0.52);
}
.need {
  min-height: 205px;
  padding: 29px;
  border-right: 1px solid var(--line);
}
.need:last-child {
  border-right: 0;
}
.need .mono {
  display: block;
  margin-bottom: 43px;
  color: var(--primary);
}
.need strong {
  display: block;
  margin-bottom: 9px;
  font-size: 18px;
}
.need p {
  margin: 0;
  font-size: 14px;
  line-height: 1.55;
}
.services-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
}
.service-card {
  min-height: 560px;
