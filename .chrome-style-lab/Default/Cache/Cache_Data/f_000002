  padding-top: 54px;
  border-top: 1px solid var(--line);
}
.education-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 30px;
}
.education-head h3 {
  max-width: 660px;
  margin: 0;
  font-size: 34px;
}
.education-head p {
  max-width: 470px;
  margin: 0;
  font-size: 14px;
}
.education-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}
.education-card {
  position: relative;
  min-height: 245px;
  display: flex;
  flex-direction: column;
  padding: 28px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--surface);
}
.education-card::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
