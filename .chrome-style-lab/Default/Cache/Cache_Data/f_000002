  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 20px;
  font-size: 13px;
}
@media (max-width: 1050px) {
  .container {
    width: min(100% - 48px, 1320px);
  }
  .nav {
    gap: 17px;
