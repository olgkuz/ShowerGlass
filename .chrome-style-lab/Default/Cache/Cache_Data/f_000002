  .nav a:nth-child(3),
  .nav a:nth-child(4) {
    display: none;
  }
  .hero {
    grid-template-columns: 1fr;
    gap: 45px;
  }
  .hero-visual {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }
  .needs {
    grid-template-columns: 1fr 1fr;
  }
  .need:nth-child(2) {
    border-right: 0;
  }
