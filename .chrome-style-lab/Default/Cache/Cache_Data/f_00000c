ion>\n\n      <section>\n        <h2>5. \u041A\u043E\u043C\u0443 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0430 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430</h2>\n        <p>\n          \u0414\u043B\u044F \u0440\u0430\u0431\u043E\u0442\u044B \u0444\u043E\u0440\u043C\u044B \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0440\u0443\u0447\u0438\u0442\u044C \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0443 \u0434\u0430\u043D\u043D\u044B\u0445 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C \u043B\u0438\u0446\u0430\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0435\n          \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u0434\u043E \u0437\u0430\u043F\u0443\u0441\u043A\u0430:\n        </p>\n        <ul>\n          <li><span class="legal-placeholder">[\u0420\u041E\u0421\u0421\u0418\u0419\u0421\u041A\u0418\u0419 \u0425\u041E\u0421\u0422\u0418\u041D\u0413-\u041F\u0420\u041E\u0412\u0410\u0419\u0414\u0415\u0420]</span> \u2014 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0441\u0430\u0439\u0442\u0430 \u0438 \u0431\u0430\u0437\u044B \u0434\u0430\u043D\u043D\u044B\u0445;</li>\n          <li><span class="legal-placeholder">[\u041F\u041E\u0427\u0422\u041E\u0412\u042B\u0419 \u0421\u0415\u0420\u0412\u0418\u0421]</span> \u2014 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0443\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u044F \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443.</li>\n        </ul>\n        <p>\n          \u041E\u0431\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0430\u043C \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0431\u044A\u0451\u043C \u0434\u0430\u043D\u043D\u044B\u0445, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B\u0439 \u0434\u043B\u044F \u0432\u044B\u043F\u043E\u0